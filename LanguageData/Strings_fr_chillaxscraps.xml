<?xml version="1.0" encoding="utf-8"?>
<base xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema" type="string">
    <tags>
        <tag language="fr" />
    </tags>
    <strings>
        <!--
            Translation Notes:
            
            By default, any of the `FunnyNote` or `Death` strings are dynamically chosen at random.
            If the `SeriousDeathMessages` option is enabled, the first `Death` message found in the file is used,
                so make this one literal and specific.
            The other ones can be puns or jokes, and options can be added or removed as needed, just make sure
                to keep the correct tags, and make sure that there is at least one message for each `Death` type.
        -->

        <!-- TN: Died if not dancing when being asked to dance with the Dance Note. -->
        <DeathItemDanceNote text="A refusé une demande de danser." />
        <DeathItemDanceNote text="Est un danseur explosif." />
        <DeathItemDanceNote text="N'a pas activé le mode Disco..." />
        <DeathItemDanceNote text="Ses entrailles foulent encore le dancefloor." />
        
        <!-- TN: Killed when a player selects your name in the Death Note. -->
        <DeathItemDeathNote text="A été sélectionné dans le Death Note." />
        <DeathItemDeathNote text="Son nom a été écrit dans le Livre de la Mort." />
        <DeathItemDeathNote text="Tué par quelqu'un ayant le pouvoir de mort." />
        
        <!-- TN: When the player is teleported to someone by an Emergency Meeting then dies shortly after. -->
        <DeathItemEmergencyMeeting text="A été appelé par un crewmate et est mort." />
        <DeathItemEmergencyMeeting text="Le cadavre signalé était le tien." />
        <DeathItemEmergencyMeeting text="A été tué par l'imposteur pendant un meeting." />
        
        <!-- TN: Died when using Freddy Fazbear too many times. -->
        <DeathItemFreddyFazbear text="A été tué par Freddy Fazbear." />
        <DeathItemFreddyFazbear text="L'ours est devenu un peu étrange." />
        
        <!-- TN: When the Nokia hits the ground near a player a low health. -->
        <DeathItemNokia text="S'est fait frapper très fort par un Nokia." />
        <DeathItemNokia text="Le Nokia était un peu trop enthousiaste." />
        <DeathItemNokia text="S'est fait Nokia." /> <!-- TN: Get it? -->
        <DeathItemNokia text="A découvert que le mythe du Nokia était fondé." />
        
        <!-- TN: Killed by Epona (Eyeless dog spawned by the Ocarina). -->
        <DeathItemOcarinaEpona text="Dévoré par Epona." />
        <DeathItemOcarinaEpona text="S'est pris un coup de sabot d'Epona." />
        <DeathItemOcarinaEpona text="Tué par un cheval très étrange." />
        <DeathItemOcarinaEpona text="A joué le mauvais son très bien." />
        
        <!-- TN: When a player is swapped with someone by an Uno Reverse Card (or Uno Reverse Card DX) and dies shortly after. -->
        <DeathItemUnoReverse text="Mort après avoir été téléporté par une carte Uno Reverse." />
        <DeathItemUnoReverse text="A été échangé avec quelqu'un et est mort." />
        <DeathItemUnoReverse text="S'est fait mélanger." />
        <DeathItemUnoReverse text="S'est fait inverser par une carte." />

    </strings>
</base>
